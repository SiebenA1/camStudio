# RealFrame Studio API 环境变量（复制为 .env 后修改）
# 数据库（默认 SQLite；生产可改 PostgreSQL，如 postgresql+psycopg://user:pass@host:5432/realframe）
DATABASE_URL=sqlite:///E:/Guo_Wenbo/camTest/apps/api/data/realframe.db
# JWT 密钥（生产必须改成随机长字符串）
SECRET_KEY=dev-secret-change-me
# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
# 调试
DEBUG=false
# 模型请求超时（秒）
MODEL_REQUEST_TIMEOUT=120
