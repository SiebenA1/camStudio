# RealFrame Studio 后端生产环境变量
# 放置到 /opt/realframe/apps/api/.env
# ⚠️ SECRET_KEY 必须在「首次配置模型 API 密钥之前」定好并保持不变：
#    模型 API Key 是用它派生的密钥加密存储的，中途更换会导致已存的 Key 无法解密（需重新填写）。

# 必改：生成方式  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# 数据库（SQLite 绝对路径为四个斜杠）
DATABASE_URL=sqlite:////opt/realframe/apps/api/data/realframe.db

# 文件存储目录（确保 realframe 用户可写）
STORAGE_DIR=/opt/realframe/apps/api/data/uploads

# 对外可访问的文件地址前缀（前端展示图片用）
# 有域名走 HTTPS 时填 https://your-domain.com/files；只有 IP 则填 http://<公网IP>/files
STORAGE_BASE_URL=https://your-domain.com/files

# CORS：同域反代部署时留空或填你的域名即可（当前代码开发态允许任意来源）
CORS_ORIGINS=https://your-domain.com

# AI 调用超时（秒）
MODEL_REQUEST_TIMEOUT=180

DEBUG=false
