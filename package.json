{
  "name": "realframe-studio",
  "private": true,
  "version": "0.1.0",
  "description": "RealFrame Studio — AI 预演 + 实拍定稿的商业摄影协作平台",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @realframe/web dev",
    "dev:api": "apps/api/.venv/Scripts/python.exe -m uvicorn app.main:app --app-dir apps/api --reload --port 8787",
    "build:web": "pnpm --filter @realframe/web build",
    "lint": "pnpm --filter @realframe/web lint"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
